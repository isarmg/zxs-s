<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="ZXS-S" Manufacturer="ZXS" Version="$(var.Version)" Language="2052"
           UpgradeCode="7030565b-5472-424c-88e1-7e63c752579d" Scope="perUser">
    <MajorUpgrade AllowSameVersionUpgrades="yes" IgnoreLanguage="yes"
                  DowngradeErrorMessage="已安装较新版本的 ZXS-S。" />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="SavedInstallFolder" Root="HKCU" Key="Software\ZXS-S"
                      Name="InstallLocation" Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ZxsAppData" Name="ZXS-S">
        <Directory Id="INSTALLFOLDER" Name="client">
          <Component Id="ZxsClient" Guid="57d6c39a-8a8f-4477-8c7d-e0fe642ec8f1">
            <File Id="ZxsExecutable" Source="$(var.ZxsBinary)" Name="zxs-cli.exe" />
            <File Id="ProjectLicense" Source="$(var.LicenseText)" Name="LICENSE.txt" />
            <RemoveFolder Id="RemoveZxsInstall" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\ZXS-S" Name="Client" Type="integer" Value="1" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\ZXS-S" Name="InstallLocation"
                           Type="string" Value="[INSTALLFOLDER]" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ZxsPrograms" Name="ZXS-S">
        <Component Id="ZxsStartMenu" Guid="7eadb397-1222-4a0a-8466-af4e4f6c36cb">
          <Shortcut Id="ZxsShortcut" Name="ZXS-S" Target="[#ZxsExecutable]" Arguments="ui" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveZxsPrograms" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\ZXS-S" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Zxs" Title="ZXS-S" Level="1">
      <ComponentRef Id="ZxsClient" />
      <ComponentRef Id="ZxsStartMenu" />
    </Feature>
  </Package>
</Wix>
