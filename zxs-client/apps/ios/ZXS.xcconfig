PRODUCT_NAME = ZXS
ZXS_APP_BUNDLE_IDENTIFIER = local.zxs.mobile
PRODUCT_BUNDLE_IDENTIFIER = $(ZXS_APP_BUNDLE_IDENTIFIER)
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
ARCHS = arm64
TARGETED_DEVICE_FAMILY = 1,2
INFOPLIST_FILE = ZXS/Info.plist
CODE_SIGN_ENTITLEMENTS = ZXS/ZXS.entitlements
SWIFT_OBJC_BRIDGING_HEADER = ZXS/Bridge.h
SWIFT_VERSION = 5.0
CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = NO
ZXS_RUST_TARGET[sdk=iphoneos*] = aarch64-apple-ios
ZXS_RUST_TARGET[sdk=iphonesimulator*] = aarch64-apple-ios-sim
ZXS_RUST_BUILD_DIR = $(CONFIGURATION_TEMP_DIR)/ZXS-Rust
ZXS_RUST_LIBRARY = $(ZXS_RUST_BUILD_DIR)/$(ZXS_RUST_TARGET)/release/libzxs_ffi.a
OTHER_LDFLAGS = $(inherited) "$(ZXS_RUST_LIBRARY)" -liconv -framework Security -framework SystemConfiguration
